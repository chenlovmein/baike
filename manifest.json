{
  "manifest_version": 3,
  "name": "百科查询",
  "version": "1.0.0",
  "description": "选中网页文字，右键跳转到百度百科、维基百科等站点查询。百科站点可自定义。",
  "permissions": [
    "contextMenus",
    "storage"
  ],
  "background": {
    "service_worker": "src/background.ts",
    "type": "module"
  },
  "options_ui": {
    "page": "src/options/index.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "打开百科查询设置",
    "default_icon": {
      "16": "public/icon-16.png",
      "48": "public/icon-48.png",
      "128": "public/icon-128.png"
    }
  },
  "icons": {
    "16": "public/icon-16.png",
    "48": "public/icon-48.png",
    "128": "public/icon-128.png"
  }
}
